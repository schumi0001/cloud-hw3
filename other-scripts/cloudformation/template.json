{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Cloud Computing HW3 - two Lambdas, REST API, photo and public frontend buckets. Reuses an existing Lex bot, Elasticsearch domain and Python dependency layer.",
  "Parameters": {
    "ElasticsearchEndpoint": {
      "Type": "String",
      "AllowedPattern": "https://.+",
      "Description": "Existing Elasticsearch/OpenSearch HTTPS endpoint.",
      "Default": "https://example.invalid"
    },
    "ElasticsearchUsername": {
      "Type": "String",
      "MinLength": 1,
      "Default": "not-configured"
    },
    "ElasticsearchPassword": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Default": "not-configured"
    },
    "LexBotId": {
      "Type": "String",
      "MinLength": 1,
      "Default": "UNSETBOTID"
    },
    "LexBotAliasId": {
      "Type": "String",
      "MinLength": 1,
      "Default": "TSTALIASID"
    },
    "LexLocaleId": {
      "Type": "String",
      "Default": "en_US"
    },
    "SearchLayerArns": {
      "Type": "CommaDelimitedList",
      "Description": "Optional existing layer ARN(s) for the application dependencies. Empty is sufficient for the basic resource-creation stack.",
      "Default": ""
    },
    "SearchArchitecture": {
      "Type": "String",
      "Default": "x86_64",
      "AllowedValues": [
        "x86_64",
        "arm64"
      ]
    },
    "IndexArchitecture": {
      "Type": "String",
      "Default": "x86_64",
      "AllowedValues": [
        "x86_64",
        "arm64"
      ]
    }
  },
  "Resources": {
    "IndexRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ResourceAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-photos-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "rekognition:DetectLabels"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          }
        ]
      }
    },
    "SearchRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ResourceAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-photos-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lex:RecognizeText"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lex:${AWS::Region}:${AWS::AccountId}:bot-alias/${LexBotId}/${LexBotAliasId}"
                  }
                }
              ]
            }
          }
        ],
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          }
        ]
      }
    },
    "IndexFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "index.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "IndexRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "Architectures": [
          {
            "Ref": "IndexArchitecture"
          }
        ],
        "Environment": {
          "Variables": {
            "ES_ENDPOINT": {
              "Ref": "ElasticsearchEndpoint"
            },
            "ES_USERNAME": {
              "Ref": "ElasticsearchUsername"
            },
            "ES_PASSWORD": {
              "Ref": "ElasticsearchPassword"
            },
            "ES_INDEX": {
              "Fn::Sub": "${AWS::StackName}-photos"
            }
          }
        },
        "Code": {
          "ZipFile": "# CloudFormation code revision: 2\nimport base64\nimport hashlib\nimport json\nimport os\nfrom urllib.error import HTTPError\nfrom urllib.parse import unquote_plus\nfrom urllib.request import Request, urlopen\n\nimport boto3\n\ns3 = boto3.client(\"s3\")\nrekognition = boto3.client(\"rekognition\")\n\nES_ENDPOINT = os.environ[\"ES_ENDPOINT\"].rstrip(\"/\")\ncredentials = (\n    f'{os.environ[\"ES_USERNAME\"]}:{os.environ[\"ES_PASSWORD\"]}'\n)\nAUTH = base64.b64encode(credentials.encode()).decode()\n\n\ndef lambda_handler(event, context):\n    indexed = 0\n\n    for record in event[\"Records\"]:\n        bucket = record[\"s3\"][\"bucket\"][\"name\"]\n        key = unquote_plus(record[\"s3\"][\"object\"][\"key\"])\n\n        if key.endswith(\"/\"):\n            continue\n\n        # Read custom labels from the uploaded object's metadata.\n        metadata = s3.head_object(Bucket=bucket, Key=key)\n        custom_labels = metadata.get(\"Metadata\", {}).get(\n            \"customlabels\", \"\"\n        ).split(\",\")\n\n        # Keep every label returned by Rekognition.\n        detection = rekognition.detect_labels(\n            Image={\"S3Object\": {\"Bucket\": bucket, \"Name\": key}},\n            MaxLabels=1000\n        )\n        detected_labels = [\n            label[\"Name\"] for label in detection[\"Labels\"]\n        ]\n\n        # Normalize labels and remove duplicates.\n        labels = list(dict.fromkeys(\n            label.strip().lower()\n            for label in custom_labels + detected_labels\n            if label.strip()\n        ))\n\n        document = {\n            \"objectKey\": key,\n            \"bucket\": bucket,\n            \"createdTimestamp\": metadata[\"LastModified\"].strftime(\n                \"%Y-%m-%dT%H:%M:%SZ\"\n            ),\n            \"labels\": labels\n        }\n\n        print(\"PHOTO_DOCUMENT:\", json.dumps(document))\n\n        # Re-uploading the same object updates its existing record.\n        document_id = hashlib.sha256(\n            f\"{bucket}/{key}\".encode()\n        ).hexdigest()\n\n        request = Request(\n            f\"{ES_ENDPOINT}/{os.environ['ES_INDEX']}/_doc/{document_id}\"\n            \"?refresh=wait_for\",\n            data=json.dumps(document).encode(\"utf-8\"),\n            headers={\n                \"Content-Type\": \"application/json\",\n                \"Authorization\": f\"Basic {AUTH}\"\n            },\n            method=\"PUT\"\n        )\n\n        try:\n            with urlopen(request, timeout=10) as response:\n                result = json.load(response)\n        except HTTPError as error:\n            print(\n                \"ELASTICSEARCH_ERROR:\",\n                error.code,\n                error.read().decode(\"utf-8\", errors=\"replace\")\n            )\n            raise\n\n        print(\"INDEX_RESULT:\", json.dumps(result))\n        indexed += 1\n\n    return {\"indexed\": indexed}"
        }
      }
    },
    "IndexFunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${IndexFunction}"
        },
        "RetentionInDays": 7
      }
    },
    "SearchFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "index.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "SearchRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "Architectures": [
          {
            "Ref": "SearchArchitecture"
          }
        ],
        "Environment": {
          "Variables": {
            "ES_ENDPOINT": {
              "Ref": "ElasticsearchEndpoint"
            },
            "ES_USERNAME": {
              "Ref": "ElasticsearchUsername"
            },
            "ES_PASSWORD": {
              "Ref": "ElasticsearchPassword"
            },
            "ES_INDEX": {
              "Fn::Sub": "${AWS::StackName}-photos"
            },
            "LEX_BOT_ID": {
              "Ref": "LexBotId"
            },
            "LEX_BOT_ALIAS_ID": {
              "Ref": "LexBotAliasId"
            },
            "LEX_LOCALE_ID": {
              "Ref": "LexLocaleId"
            }
          }
        },
        "Code": {
          "ZipFile": "# CloudFormation code revision: 2\nimport json\nimport logging\nimport os\nimport uuid\nfrom urllib.parse import urlparse\n\nimport boto3\nimport certifi\nfrom botocore.config import Config\nfrom elasticsearch import Elasticsearch\nfrom elasticsearch.helpers import scan\n\nlogger = logging.getLogger()\nlogger.setLevel(logging.INFO)\n\nlex = boto3.client(\"lexv2-runtime\")\ns3 = boto3.client(\n    \"s3\",\n    config=Config(signature_version=\"s3v4\")\n)\n\nendpoint = urlparse(os.environ[\"ES_ENDPOINT\"])\nes = Elasticsearch(\n    [{\n        \"host\": endpoint.hostname,\n        \"port\": endpoint.port or 443,\n        \"use_ssl\": True\n    }],\n    http_auth=(\n        os.environ[\"ES_USERNAME\"],\n        os.environ[\"ES_PASSWORD\"]\n    ),\n    verify_certs=True,\n    ca_certs=certifi.where(),\n    timeout=10,\n    max_retries=1\n)\n\n\ndef respond(status, payload):\n    return {\n        \"statusCode\": status,\n        \"headers\": {\n            \"Content-Type\": \"application/json\",\n            \"Access-Control-Allow-Origin\": \"*\"\n        },\n        \"body\": json.dumps(payload)\n    }\n\n\ndef extract_keywords(lex_response):\n    intent = lex_response.get(\"sessionState\", {}).get(\"intent\", {})\n    if intent.get(\"name\") != \"SearchIntent\":\n        return []\n\n    slot = (intent.get(\"slots\") or {}).get(\"Keywords\")\n    if not slot:\n        return []\n\n    entries = (\n        slot.get(\"values\", [])\n        if slot.get(\"shape\") == \"List\"\n        else [slot]\n    )\n\n    keywords = []\n    for entry in entries:\n        value = entry.get(\"value\") or {}\n        text = (\n            value.get(\"originalValue\")\n            or value.get(\"interpretedValue\")\n            or \"\"\n        ).strip().lower()\n        if text and text not in keywords:\n            keywords.append(text)\n\n    return keywords\n\n\ndef lambda_handler(event, context):\n    parameters = event.get(\"queryStringParameters\") or {}\n    query = parameters.get(\"q\") or event.get(\"q\") or \"\"\n\n    if not isinstance(query, str) or len(query) > 1024:\n        return respond(400, {\n            \"code\": 400,\n            \"message\": \"q must be text of at most 1024 characters.\"\n        })\n\n    query = query.strip()\n    if not query:\n        return respond(200, {\"results\": []})\n\n    try:\n        lex_response = lex.recognize_text(\n            botId=os.environ[\"LEX_BOT_ID\"],\n            botAliasId=os.environ[\"LEX_BOT_ALIAS_ID\"],\n            localeId=os.environ[\"LEX_LOCALE_ID\"],\n            sessionId=uuid.uuid4().hex,\n            text=query\n        )\n\n        keywords = extract_keywords(lex_response)\n        logger.info(\"KEYWORDS: %s\", json.dumps(keywords))\n\n        if not keywords:\n            return respond(200, {\"results\": []})\n\n        # Return photos matching any requested keyword.\n        search_body = {\n            \"_source\": [\"bucket\", \"objectKey\", \"labels\"],\n            \"query\": {\n                \"bool\": {\n                    \"should\": [\n                        {\"match_phrase\": {\"labels\": keyword}}\n                        for keyword in keywords\n                    ],\n                    \"minimum_should_match\": 1\n                }\n            }\n        }\n\n        results = []\n        for hit in scan(\n            es,\n            index=os.environ[\"ES_INDEX\"],\n            query=search_body,\n            size=500,\n            scroll=\"1m\",\n            request_timeout=10\n        ):\n            photo = hit[\"_source\"]\n            url = s3.generate_presigned_url(\n                \"get_object\",\n                Params={\n                    \"Bucket\": photo[\"bucket\"],\n                    \"Key\": photo[\"objectKey\"]\n                },\n                ExpiresIn=3600\n            )\n            results.append({\n                \"url\": url,\n                \"labels\": photo.get(\"labels\", [])\n            })\n\n        logger.info(\"MATCH_COUNT: %s\", len(results))\n        return respond(200, {\"results\": results})\n\n    except Exception:\n        logger.exception(\"Photo search failed\")\n        return respond(500, {\n            \"code\": 500,\n            \"message\": \"Photo search failed. Check Lambda logs.\"\n        })"
        },
        "Layers": {
          "Fn::If": [
            "HasSearchLayers",
            {
              "Ref": "SearchLayerArns"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "SearchFunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${SearchFunction}"
        },
        "RetentionInDays": 7
      }
    },
    "PhotoInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "IndexFunction"
        },
        "Principal": "s3.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-photos-${AWS::AccountId}-${AWS::Region}"
        }
      }
    },
    "PhotoBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-photos-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "NotificationConfiguration": {
          "LambdaConfigurations": [
            {
              "Event": "s3:ObjectCreated:Put",
              "Function": {
                "Fn::GetAtt": [
                  "IndexFunction",
                  "Arn"
                ]
              }
            }
          ]
        }
      },
      "DependsOn": [
        "PhotoInvokePermission"
      ]
    },
    "FrontendBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "WebsiteConfiguration": {
          "IndexDocument": "index.html"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": false,
          "RestrictPublicBuckets": false
        }
      }
    },
    "FrontendPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "FrontendBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${FrontendBucket.Arn}/*"
              }
            }
          ]
        }
      }
    },
    "ApiS3Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "apigateway.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ResourceAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-photos-${AWS::AccountId}-${AWS::Region}/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "PhotoApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        },
        "BinaryMediaTypes": [
          "image/png",
          "image/jpeg",
          "application/octet-stream"
        ],
        "ApiKeySourceType": "HEADER"
      }
    },
    "PhotosResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "PhotoApi",
            "RootResourceId"
          ]
        },
        "PathPart": "photos"
      }
    },
    "SearchResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "PhotoApi",
            "RootResourceId"
          ]
        },
        "PathPart": "search"
      }
    },
    "ParameterValidator": {
      "Type": "AWS::ApiGateway::RequestValidator",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ValidateRequestBody": false,
        "ValidateRequestParameters": true
      }
    },
    "UploadMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ResourceId": {
          "Ref": "PhotosResource"
        },
        "HttpMethod": "PUT",
        "AuthorizationType": "NONE",
        "ApiKeyRequired": true,
        "RequestValidatorId": {
          "Ref": "ParameterValidator"
        },
        "RequestParameters": {
          "method.request.querystring.filename": true,
          "method.request.header.Content-Type": true,
          "method.request.header.x-amz-meta-customLabels": false
        },
        "Integration": {
          "Type": "AWS",
          "IntegrationHttpMethod": "PUT",
          "Credentials": {
            "Fn::GetAtt": [
              "ApiS3Role",
              "Arn"
            ]
          },
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:s3:path/${PhotoBucket}/{object}"
          },
          "PassthroughBehavior": "WHEN_NO_MATCH",
          "RequestParameters": {
            "integration.request.path.object": "method.request.querystring.filename",
            "integration.request.header.Content-Type": "method.request.header.Content-Type",
            "integration.request.header.x-amz-meta-customLabels": "method.request.header.x-amz-meta-customLabels"
          },
          "IntegrationResponses": [
            {
              "StatusCode": "200",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Origin": "'*'",
                "method.response.header.Content-Type": "'application/json'"
              },
              "ResponseTemplates": {
                "application/json": "{\"code\": 200, \"message\": \"Photo uploaded.\"}"
              }
            },
            {
              "StatusCode": "400",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Origin": "'*'",
                "method.response.header.Content-Type": "'application/json'"
              },
              "ResponseTemplates": {
                "application/json": "{\"code\": 400, \"message\": \"S3 rejected the upload.\"}"
              },
              "SelectionPattern": "4[0-9]{2}"
            },
            {
              "StatusCode": "500",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Origin": "'*'",
                "method.response.header.Content-Type": "'application/json'"
              },
              "ResponseTemplates": {
                "application/json": "{\"code\": 500, \"message\": \"S3 upload failed.\"}"
              },
              "SelectionPattern": "5[0-9]{2}"
            }
          ]
        },
        "MethodResponses": [
          {
            "StatusCode": "200",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Origin": false,
              "method.response.header.Content-Type": false
            }
          },
          {
            "StatusCode": "400",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Origin": false,
              "method.response.header.Content-Type": false
            }
          },
          {
            "StatusCode": "500",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Origin": false,
              "method.response.header.Content-Type": false
            }
          }
        ]
      }
    },
    "SearchMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ResourceId": {
          "Ref": "SearchResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "ApiKeyRequired": true,
        "RequestParameters": {
          "method.request.querystring.q": false
        },
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${SearchFunction.Arn}/invocations"
          }
        }
      }
    },
    "ApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "SearchFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${PhotoApi}/*/GET/search"
        }
      }
    },
    "PhotosOptions": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "PhotoApi"
        },
        "ResourceId": {
          "Ref": "PhotosResource"
        },
        "HttpMethod": "OPTIONS",
        "AuthorizationType": "NONE",
        "ApiKeyRequired": false,
        "Integration": {
          "Type": "MOCK",
          "RequestTemplates": {
